# Local development without Docker. Copy to .env and adjust.
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/vishanti
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
# 3600 in production. 60 makes one SLA hour last one minute (live demo).
SLA_HOUR_SECONDS=60
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
# "hashing" if sentence-transformers is not installed
EMBEDDINGS_BACKEND=auto
CORS_ORIGINS=http://localhost:3000
# Optional: publish daily checkpoints to a public gist
# GITHUB_TOKEN=
# CHECKPOINT_GIST_ID=
